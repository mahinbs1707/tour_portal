# Tour Portal local Compose baseline (placeholders only — copy to `.env` and change secrets)
# Bring-up: copy this file to `.env`, then follow README Compose steps.

# Host port published for Nginx (container listens on 80)
HOST_PORT=8080

# Django
DJANGO_SECRET_KEY=change-me-generate-a-local-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080
BUSINESS_TIMEZONE=Asia/Dhaka
MEDIA_ROOT=/media
# Max Admin package image upload size in bytes (illustrative default; product may change).
MEDIA_UPLOAD_MAX_BYTES=5242880

# PostgreSQL
POSTGRES_DB=tourportal
POSTGRES_USER=tourportal
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Optional local AI stub (no real provider keys)
AI_PROVIDER=mock

# Admin seed (Story 1.3) — leave blank to skip automatic seed on bring-up.
# To enable: set both to non-empty values in your local `.env` (never commit real secrets).
# Example: ADMIN_EMAIL=admin@example.com / ADMIN_PASSWORD=<strong local password>
# When both are set, the backend entrypoint runs `python manage.py seed_admin`
# after migrate (idempotent upsert by email: role=ADMIN, is_staff=True).
# Whitespace-only values are treated as unset. Optional: ADMIN_FULL_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
